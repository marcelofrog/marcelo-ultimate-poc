# -----------------------------------------------------------------------------
# JFrog Ultimate POC - environment configuration
# Copy this file to `.env` and edit the values before running any setup script.
#
# NOTE: this file contains **zero credentials**. All JFrog authentication is
# taken from the active `jfrog config add` CLI profile — set that up once
# before running any script:
#
#   jf c add poc-admin --interactive
#   jf c use poc-admin
#
# The scripts read the URL, the token, everything from that profile.
# -----------------------------------------------------------------------------

# Name of the local `jf c` profile the setup scripts should use.
# Defaults to whatever profile is currently active — override only if you
# keep multiple JFrog instances configured on your workstation.
JF_CLI_PROFILE=""

# AppTrust application name. Also used as prefix for every JFrog object.
# Keep it short, lowercase, alphanumeric+dash.
POC_APP_NAME="ultimate-demo"

# JFrog Project key for the AppTrust application. Must be 2-10 chars,
# lowercase alphanumeric + dashes, starting with a letter.
POC_PROJECT_KEY="mypoc"

# GitHub repo (owner/repo) that will run the workflows
POC_GITHUB_REPO="your-org/ultimate-poc"

# Rego test-count gate threshold — minimum number of passing tests required
# before an application version can be promoted.
POC_MIN_PASSING_TESTS=3

# Security gate CVE threshold (block if any applicable CVE >= this score)
POC_CVE_BLOCK_THRESHOLD=9.0
